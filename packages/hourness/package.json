{
  "name": "dsh-hourness",
  "version": "0.3.1",
  "description": "Orchestration layer for DeepSeek Harness: project graph and its sidebar panel, guard rails, audit journals, memory, the /wish main-agent flow, and the /hourness morning report.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "orchestration",
    "project-graph",
    "guard",
    "memory",
    "plugin"
  ],
  "homepage": "https://github.com/SunNorthGod/GLM-Hourness/tree/main/packages/hourness#readme",
  "bugs": {
    "url": "https://github.com/SunNorthGod/GLM-Hourness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunNorthGod/GLM-Hourness.git",
    "directory": "packages/hourness"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.3"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "dist",
    "ui",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": "./ui/index.js",
    "./client": "./ui/client.js",
    "./data": "./dist/data/index.js",
    "./guard": "./dist/guard/index.js",
    "./memory": "./dist/memory/index.js",
    "./lessons": "./dist/lessons/index.js",
    "./workflow": "./dist/workflow/index.js",
    "./hourness": "./dist/report/index.js",
    "./graph": "./dist/graph/index.js",
    "./graph-panel": "./dist/graph/panel-row.js",
    "./rules": "./dist/rules/index.js",
    "./design": "./dist/design/index.js",
    "./execute": "./dist/execute/index.js",
    "./loops": "./dist/loops/index.js",
    "./data/locale/*.json": "./locale/data/*.json",
    "./guard/locale/*.json": "./locale/guard/*.json",
    "./memory/locale/*.json": "./locale/memory/*.json",
    "./lessons/locale/*.json": "./locale/lessons/*.json",
    "./workflow/locale/*.json": "./locale/workflow/*.json",
    "./hourness/locale/*.json": "./locale/hourness/*.json",
    "./graph/locale/*.json": "./locale/graph/*.json",
    "./graph-panel/locale/*.json": "./locale/graph-panel/*.json",
    "./rules/locale/*.json": "./locale/rules/*.json",
    "./design/locale/*.json": "./locale/design/*.json",
    "./execute/locale/*.json": "./locale/execute/*.json",
    "./loops/locale/*.json": "./locale/loops/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*"
  }
}
