{
  "name": "dsh-glm-zcode",
  "version": "0.3.0",
  "description": "ZCode-compatible GLM channel for DeepSeek Harness: native account login, identity headers, request signing, prompt and tool surface mirroring ZCode 3.17.1, lazy tool loading and compaction.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "glm",
    "zcode",
    "llm",
    "plugin"
  ],
  "homepage": "https://github.com/SunNorthGod/GLM-Hourness/tree/main/packages/glm#readme",
  "bugs": {
    "url": "https://github.com/SunNorthGod/GLM-Hourness/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunNorthGod/GLM-Hourness.git",
    "directory": "packages/glm"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.3"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "dist",
    "ui",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": "./ui/index.js",
    "./client": "./ui/client.js",
    "./glm-llm": "./dist/glm-llm/index.js",
    "./glm-login": "./dist/glm-llm/login-row.js",
    "./glm-prompt": "./dist/glm-prompt/index.js",
    "./glm-compact": "./dist/glm-prompt/compact-row.js",
    "./glm-llm/locale/*.json": "./locale/glm-llm/*.json",
    "./glm-login/locale/*.json": "./locale/glm-login/*.json",
    "./glm-prompt/locale/*.json": "./locale/glm-prompt/*.json",
    "./glm-compact/locale/*.json": "./locale/glm-compact/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*"
  }
}
