node_modules/
dist/
.llm/
.pnpm-store/
/reference/
*.tsbuildinfo
# 编排任务目录：只有文稿入库（设计、一页放行稿、评审记录、简报、实施计划、草图），
# 它们是换机器或换 IDE 之后唯一能读懂现状的材料；运行产物、日志与一次性脚本不入库。
.agents/*
!.agents/tasks/
.agents/tasks/**/*
!.agents/tasks/**/
!.agents/tasks/**/*.md
!.agents/tasks/**/*.svg
.agents/tasks/**/runs/
# wire-run 是探针式运行目录（含嵌套的会话路径，Windows 上超过路径长度上限，git 遍历时报 Filename too long）。
.agents/tasks/**/wire-run/
# 仓库根目录的门禁与探针日志（.llm-<任务>-<步骤>.log），一次性运行产物。
/.llm-*.log
.worktrees/
.kiro/
# Built by scripts/build-ui.mjs from ui/src (npm run build).
/packages/*/ui/client.js

# npms lockfile: the repository keeps pnpm-lock.yaml only.
package-lock.json
